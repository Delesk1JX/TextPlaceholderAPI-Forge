# Normalise line endings so the sources check out identically on Windows and Linux.
* text=auto

*.java   text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.toml   text eol=lf
*.md     text eol=lf
*.mcmeta text eol=lf
LICENSE  text eol=lf
*.png    binary
*.jar    binary

# Keep the wrapper executable bit set; without this it is checked out as 644 on Unix.
gradlew text eol=lf
